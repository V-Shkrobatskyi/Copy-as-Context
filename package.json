{
  "name": "copy-as-context",
  "description": "Local Chrome extension for copying semantic page context.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:firefox:android-test": "wxt build -b firefox --mode android-test",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check:firefox-package": "node scripts/check-firefox-package.mjs",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run compile && npm test && npm run build && npm run build:firefox && npm run check:browser-builds && npm run lint:firefox",
    "check:browser-builds": "node scripts/check-browser-builds.mjs",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "4.1.11",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
