{
  "3rdparty": {
    "extensions": {
      "REPLACE_WITH_CHROME_EXTENSION_ID": {
        "PolicyVersion": 1,
        "ElementPickerAllowed": false,
        "FileExportAllowed": false,
        "ClipboardExportAllowed": true,
        "AllowedExportFormats": [
          "semantic-text"
        ],
        "ForcedCompression": "compact",
        "RedactionMode": "force-on",
        "RequiredBuiltinFilters": [
          "authorization",
          "jwt",
          "github",
          "aws",
          "email-hide"
        ],
        "UserRedactionRulesAllowed": false,
        "UserPreferencesSaveAllowed": false,
        "PreviewAllowed": false,
        "FilterSettingsAllowed": false,
        "DisabledBuiltinFilters": [
          "email-mask-domain"
        ]
      }
    }
  }
}
